# Optional fallbacks when the Kissflow SDK is not available (e.g. local Vite dev).
# In Kissflow embedded runtime, account / app / process ids are read from `window.kf`.
# Copy to `.env` locally — do not commit real secrets.

VITE_KF_BASE_URL=https://refexgroup.kissflow.com
VITE_KF_ACCOUNT_ID=AcCMptlq60zH
VITE_KF_APPLICATION_ID=
# Optional override for My Team process-report keys (defaults are in src/kfReportApi.js)
# VITE_KF_ACCESS_KEY_ID=
# VITE_KF_ACCESS_KEY_SECRET=
# Process technical name in API paths (e.g. Lead_tracker_1_A00), not always equal to application id.
VITE_KF_LEAD_PROCESS_ID=Lead_tracker_1_A00
# Venwind Sales dashboard (VWLeadDashboardPage) — process under Lead Tracker app.
# https://development-refexgroup.kissflow.com/appbuilder/Lead_Trcaker_A00/process/Vindview_Sales_Management_A00
VITE_KF_VENWIND_APPLICATION_ID=Lead_Trcaker_A00
VITE_KF_VENWIND_PROCESS_ID=Vindview_Sales_Management_A00
# 3i Sales Opportunity funnel (LeadSalesOpportunityPage)
# https://refexgroup.kissflow.com/appbuilder/Lead_Trcaker_A00/process/3i_Sales_Opportunity_A00
VITE_KF_SALES_OPP_APPLICATION_ID=Lead_Trcaker_A00
VITE_KF_SALES_OPP_PROCESS_ID=3i_Sales_Opportunity_A00
VITE_KF_SALES_OPP_POPUP_ID=
# Sales Team Activity (3iOppSalesActivity)
# https://development-refexgroup.kissflow.com/appbuilder/Lead_Trcaker_A00/process/Sales_Activity_Module_A00
VITE_KF_SALES_ACTIVITY_PROCESS_ID=Sales_Activity_Module_A00
# Process-report id for My Team tab (LeadsManagementHubPage).
VITE_KF_MY_TEAM_REPORT_ID=My_Team_A00
