# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Email recipients (comma-separated)
REPORT_TO=manager@example.com,lead@example.com
REPORT_FROM=reports@example.com
REPORT_SUBJECT=User Adoption Report — Daily Summary

# Cron schedule (default: every weekday at 8:00 AM IST)
CRON_SCHEDULE=0 8 * * 1-5
